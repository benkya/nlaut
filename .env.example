# nlaut 环境变量模板
# 复制为 ~/.hermes/.env 或项目的 .env，填入真实 key
# key 不进 git（.gitignore 已排除）

# === 被测大模型 API Key ===
# 按需配置，只配你要测的模型

# 阿里云百炼（glm-5.2/glm-5.3/glm-5/qwen3.7-max 共用）
CUSTOM_API_KEY=

# DeepSeek 官方 API
DEEPSEEK_API_KEY=

# 阿里 DashScope
DASHSCOPE_API_KEY=

# 内网 DeepSeek-V4-Flash
DEEPSEEK_V4_FLASH_KEY=

# 内网 DeepSeek-V4-Pro-0813
HERMES_CUSTOM_DEEPSEEK_V4_PRO_API_KEY=

# 内网 Qwen3.8-Flash-Next
QWEN38_FLASH_KEY=

# === 飞书集成（可选）===
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# === 本地模型权重下载代理（可选，HF 直连不通时用）===
# export https_proxy=http://127.0.0.1:7897
# export http_proxy=http://127.0.0.1:7897
